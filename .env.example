# GEMINI_API_KEY: Optional if using Local Ollama or Autonomous engine.
# Set your Gemini API key for high-speed cloud multimodal reasoning.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT=3000

# LOCAL_LLM_ENDPOINT: Default local inference endpoint (Ollama / LM Studio)
LOCAL_LLM_ENDPOINT="http://localhost:11434"

# LOCAL_LLM_MODEL: Default local model name (e.g. llama3.2, mistral, deepseek-r1)
LOCAL_LLM_MODEL="llama3.2"
